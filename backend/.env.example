DATABASE_URL="postgresql://olivier@localhost:5432/training_scheduler?schema=public"
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Production on the sandbox EC2:
# FRONTEND_ORIGIN=https://training-scheduler.lefolio.fr
# API_PUBLIC_URL=https://training-scheduler.lefolio.fr

SESSION_SECRET=change-me-to-a-long-random-string
NODE_ENV=development

# Resend — leave unset locally to log the OTP to the API console
RESEND_API_KEY=
RESEND_FROM="Training Scheduler <noreply@lefolio.fr>"

# Google OAuth (Web client). Add these Authorized redirect URIs:
#   http://localhost:3000/api/auth/google/callback
#   http://localhost:3000/api/auth/drive/callback
#   https://training-scheduler.lefolio.fr/api/auth/google/callback
#   https://training-scheduler.lefolio.fr/api/auth/drive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
GOOGLE_DRIVE_CALLBACK_URL=http://localhost:3000/api/auth/drive/callback
# Browser API key with Google Picker API enabled (HTTP referrer restricted).
# App ID defaults to the numeric prefix of GOOGLE_CLIENT_ID if unset.
GOOGLE_API_KEY=
GOOGLE_APP_ID=

# LLM for PDF / Google Doc → schedule. groq or openrouter
# Bench notes: wiki/llm-extraction-bench.md
LLM_PROVIDER=openrouter
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
